NEXT_PUBLIC_API_URL=http://localhost:8000
# Theater token for /api/state, /api/events and the stream (read-only; public by design)
NEXT_PUBLIC_THEATER_TOKEN=
# Hosts the theater may load social images from (match the gateway's PUBLIC_ASSET_HOSTS)
NEXT_PUBLIC_ASSET_HOSTS=
# Theater flags (default on): set to 0 to hide
# NEXT_PUBLIC_SHOW_BLOCKED=1
# NEXT_PUBLIC_SHOW_QUEUE=1
