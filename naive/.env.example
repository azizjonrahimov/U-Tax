# naive/ env: names only, never values in git. Export these in your shell before `naive up` (the config reads process.env).

# Naïve API key (sk_live_...). Overrides the CLI profile. Needed for `naive up` (and --dry-run).
NAIVE_API_KEY=

# The U-Tax gateway's PUBLIC HTTPS MCP base, ending in /mcp; each agent calls <base>/<actor> (contract v1.4) (Naïve refuses http, localhost, private hosts).
# Tonight: a cloudflared tunnel to backend port 8000, e.g. https://<random>.trycloudflare.com/mcp
# Saturday: the Render URL + /mcp
UTAX_MCP_URL=

# One gateway tool token per agent (contract v1.3 §1): the same values as the backend's. Each 32+ characters,
# all different (openssl rand -hex 32). The token decides which agent is calling and which tools it may use.
# `naive up` seals each into that agent's own vault (utax-<actor>-secrets) as a static_bearer for UTAX_MCP_URL.
UTAX_TOOL_TOKEN_COS=
UTAX_TOOL_TOKEN_INTAKE=
UTAX_TOOL_TOKEN_TAX=
UTAX_TOOL_TOKEN_QA=
UTAX_TOOL_TOKEN_ACCT=
UTAX_TOOL_TOKEN_MKT=
UTAX_TOOL_TOKEN_HR=

# Optional, off by default. A Naïve number the owner already bought (E.164, e.g. +14155550123).
# When set, inbound SMS to it wakes the Chief of Staff. Naïve numbers have no voice; the firm can't text back.
UTAX_PHONE_E164=
