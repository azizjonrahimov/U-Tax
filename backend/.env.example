# Copy to backend/.env (gitignored) and fill in. Never commit real values.
# Empty token = that check is off (local dev only).

# --- Naive REST (agents' platform) ---
NAIVE_API_KEY=
NAIVE_API_BASE=https://api.vetta.sh
# ADAPTER_SOCIAL=naive posts through this identity's social workspace (its id or name). Owner
# steps: POST /v1/identities/<id>/social/activate, then open the link from
# POST /v1/identities/<id>/social/portal and connect the X and LinkedIn accounts.
NAIVE_SOCIAL_IDENTITY=utax-mkt

# --- Auth tokens (contract §1, v1.3) ---
# One MCP tool token per agent, each >= 32 chars; the token decides the actor. Always required.
UTAX_TOOL_TOKEN_COS=
UTAX_TOOL_TOKEN_INTAKE=
UTAX_TOOL_TOKEN_TAX=
UTAX_TOOL_TOKEN_QA=
UTAX_TOOL_TOKEN_ACCT=
UTAX_TOOL_TOKEN_MKT=
UTAX_TOOL_TOKEN_HR=
# Theater and admin tokens: empty disables the check (local dev only).
THEATER_TOKEN=
ADMIN_TOKEN=
# comma-separated; the theater runs on :3200 tonight
THEATER_ORIGIN=http://localhost:3200

# --- Event store: jsonl (default, backend/data/events.jsonl) | postgres ---
STORE=jsonl
EVENTS_PATH=
DATABASE_URL=
UTAX_DATA_DIR=

# --- Ports: local stand-ins today; sponsor names fail at boot until their adapter lands ---
# local | agentmail (needs AGENTMAIL_API_KEY and MAIL_INBOX_CLIENTS; see below)
ADAPTER_MAIL=local
# local | openrouter | openai
ADAPTER_LLM=local
# local | hubspot
ADAPTER_CRM=local
# local | mobilerun (needs MOBILERUN_API_KEY, MOBILERUN_MEMO_SENDER, MAIL_QA_BCC and
# ADAPTER_MAIL=agentmail)
ADAPTER_DEVICE=local
# local | apify (needs APIFY_TOKEN; each run is capped at $0.10)
ADAPTER_SCRAPE=local
# local | monid
ADAPTER_TOOLBUY=local
# none | openai   (mic page + brief audio)
ADAPTER_VOICE=none
# local | agentmail (design D27: an event on the clients inbox's calendar plus an
# iCalendar invitation to the client; needs AGENTMAIL_API_KEY and MAIL_INBOX_CLIENTS)
ADAPTER_CALENDAR=local
# local | naive (needs NAIVE_API_KEY and NAIVE_SOCIAL_IDENTITY)
ADAPTER_SOCIAL=local
# none | stripe
ADAPTER_PAY=none

# --- Voice (contract v1.1): without it, /api/voice/session and /api/brief/audio answer 503 ---
OPENAI_API_KEY=

# --- CEO updates (contract §5, D24): approvals, BLOCKED cases, a digest every N hours ---
CEO_EMAIL=
CEO_DIGEST_HOURS=3

# --- Two inboxes (contract §6c): AgentMail addresses Saturday ---
MAIL_INBOX_CLIENTS=
MAIL_INBOX_HIRING=

# --- AgentMail (ADAPTER_MAIL=agentmail, task 8) ---
# API key from the AgentMail console. MAIL_INBOX_CLIENTS (required) and MAIL_INBOX_HIRING
# are the inbox addresses, which are also their inbox ids.
AGENTMAIL_API_KEY=
# The webhook's signing secret (whsec_...): create a webhook for message.received pointing
# at https://<public-host>/hooks/agentmail, scoped to the two inboxes. Without it,
# /hooks/agentmail needs the header X-UTax-Hook-Token: <UTAX_HOOK_TOKEN> (a relay you run
# yourself); with neither it answers 503.
AGENTMAIL_WEBHOOK_SECRET=
AGENTMAIL_BASE_URL=https://api.agentmail.to
UTAX_HOOK_TOKEN=
# The review call's meeting link or phone number, shown on the calendar invitation
UTAX_CALL_LOCATION=

# --- QA phone check (ADAPTER_DEVICE=mobilerun, contract v1.7) ---
# Every memo is BCC'd to this mailbox; the cloud phone's mail app is signed in to it and
# finds each memo by its "Reference: UTX-..." last line.
MAIL_QA_BCC=
MOBILERUN_API_KEY=
# Optional: a fixed cloud phone; else the first idle Android cloud phone of the account
MOBILERUN_DEVICE_ID=
# Optional: the mail app package (default com.google.android.gm)
MOBILERUN_MAIL_APP=
# Required with mobilerun: only memos from this sender count (the clients inbox address)
MOBILERUN_MEMO_SENDER=
# Optional: the phone agent's model (default mobilerun/mobile-agent-fast)
MOBILERUN_MODEL=

# --- Apify (ADAPTER_SCRAPE=apify): the Delaware fee page and law search ---
APIFY_TOKEN=

# --- Local demo (design D26): the in-process stand-in crew plays the agents ---
# UTAX_DRIVER=local enables it; UTAX_DRIVER_PACE = seconds between tool calls (theater).
UTAX_DRIVER=
UTAX_DRIVER_PACE=1.2

# --- Posts (v1.4/v1.5): required; the gateway appends it to client posts ---
PUBLIC_TALK_URL=
# v1.6.4: a post's image_url must be https on one of these hosts (comma-separated);
# empty = posts carry no image
PUBLIC_ASSET_HOSTS=

# --- Public /talk (v1.5): "event" raises the per-IP limit to 60/min (venue NAT) ---
PUBLIC_MODE=

# --- CEO console link in CEO mails; templates and the voice prompt (contract §6d) ---
CEO_CONSOLE_URL=http://localhost:3200/ceo
UTAX_TEMPLATES_DIR=
UTAX_VOICE_PROMPT=

# --- Voice (OpenAI; only used with ADAPTER_VOICE=openai and a key) ---
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- SSE heartbeat seconds (contract: 15) ---
UTAX_SSE_HEARTBEAT=15

# --- Caps ---
CAP_PER_HOUR=10
SPEND_CAP_USD=
