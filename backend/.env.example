# Copy to backend/.env (gitignored) and fill in. Never commit real values.
# Empty token = that check is off (local dev only).

# --- Naive REST (agents' platform) ---
NAIVE_API_KEY=
NAIVE_API_BASE=https://api.vetta.sh

# --- Auth tokens (contract §1, v1.3) ---
# One MCP tool token per agent, each >= 32 chars; the token decides the actor. Always required.
UTAX_TOOL_TOKEN_COS=
UTAX_TOOL_TOKEN_INTAKE=
UTAX_TOOL_TOKEN_TAX=
UTAX_TOOL_TOKEN_QA=
UTAX_TOOL_TOKEN_ACCT=
UTAX_TOOL_TOKEN_MKT=
UTAX_TOOL_TOKEN_HR=
# Theater and admin tokens: empty disables the check (local dev only).
THEATER_TOKEN=
ADMIN_TOKEN=
THEATER_ORIGIN=

# --- Event store: jsonl (default, backend/data/events.jsonl) | postgres ---
STORE=jsonl
EVENTS_PATH=
DATABASE_URL=
UTAX_DATA_DIR=

# --- Ports: local stand-ins today; sponsor names fail at boot until their adapter lands ---
# local | agentmail
ADAPTER_MAIL=local
# local | openrouter | openai
ADAPTER_LLM=local
# local | hubspot
ADAPTER_CRM=local
# local | mobilerun
ADAPTER_DEVICE=local
# local | apify
ADAPTER_SCRAPE=local
# local | monid
ADAPTER_TOOLBUY=local
# none | openai   (mic page + brief audio)
ADAPTER_VOICE=none
# local | google
ADAPTER_CALENDAR=local
# local | naive
ADAPTER_SOCIAL=local
# none | stripe
ADAPTER_PAY=none

# --- Voice (contract v1.1): without it, /api/voice/session and /api/brief/audio answer 503 ---
OPENAI_API_KEY=

# --- CEO updates (contract §5, D24): approvals, BLOCKED cases, a digest every N hours ---
CEO_EMAIL=
CEO_DIGEST_HOURS=3

# --- Two inboxes (contract §6c): AgentMail addresses Saturday ---
MAIL_INBOX_CLIENTS=
MAIL_INBOX_HIRING=

# --- Caps ---
CAP_PER_HOUR=10
SPEND_CAP_USD=
