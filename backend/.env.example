# Copy to backend/.env (gitignored) and fill in. Never commit real values.
# Empty token = that check is off (local dev only).

# --- Naive REST (agents' platform) ---
NAIVE_API_KEY=
NAIVE_API_BASE=https://api.vetta.sh
# v1.9 §6b-bis (D29): with NAIVE_API_KEY set (scopes agents:read, sessions:read, sessions:write) the
# gateway answers Naive's data-leak confirms for the 7 U-Tax agents (board + own utax tools
# allowed, anything else denied with a CEO notice). off disables it.
UTAX_NAIVE_CONFIRM=
# ADAPTER_SOCIAL=naive posts through this identity's social workspace (its id or name). Owner
# steps: POST /v1/identities/<id>/social/activate, then open the link from
# POST /v1/identities/<id>/social/portal and connect the X and LinkedIn accounts.
NAIVE_SOCIAL_IDENTITY=utax-mkt

# --- Auth tokens (contract §1, v1.3) ---
# One MCP tool token per agent, each >= 32 chars; the token decides the actor. Always required.
UTAX_TOOL_TOKEN_COS=
UTAX_TOOL_TOKEN_INTAKE=
UTAX_TOOL_TOKEN_TAX=
UTAX_TOOL_TOKEN_QA=
UTAX_TOOL_TOKEN_ACCT=
UTAX_TOOL_TOKEN_MKT=
UTAX_TOOL_TOKEN_HR=
# v1.14: the CEO assistant's /mcp/ceo seat (generated into .env at first boot when unset)
UTAX_TOOL_TOKEN_CEO=
# Theater and admin tokens: empty disables the check (local dev only). The gateway refuses
# to boot with either one empty when STORE=postgres, PUBLIC_MODE=event or PUBLIC_TALK_URL
# is https.
THEATER_TOKEN=
ADMIN_TOKEN=
# v1.13 (D33): the CEO signs in at /ceo with CEO_EMAIL and a password. Set the hash with
#   python -m app.devtools set-ceo-password   (reads the password, never echoes it)
CEO_PASSWORD_HASH=
# signs the CEO's 12 h sessions; generated and saved here at first boot if empty
UTAX_SESSION_SECRET=
# comma-separated; the theater runs on :3200 tonight
THEATER_ORIGIN=http://localhost:3200

# --- Event store: jsonl (default, backend/data/events.jsonl) | postgres ---
STORE=jsonl
EVENTS_PATH=
DATABASE_URL=
UTAX_DATA_DIR=

# --- Ports: local stand-ins today; sponsor names fail at boot until their adapter lands ---
# local | agentmail (needs AGENTMAIL_API_KEY and MAIL_INBOX_CLIENTS; see below)
ADAPTER_MAIL=local
# local | openrouter | openai
ADAPTER_LLM=local
# local | hubspot (needs HUBSPOT_TOKEN; see below)
ADAPTER_CRM=local
# local | mobilerun (needs MOBILERUN_API_KEY, MOBILERUN_MEMO_SENDER, MAIL_QA_BCC and
# ADAPTER_MAIL=agentmail)
ADAPTER_DEVICE=local
# local | apify (needs APIFY_TOKEN; each run is capped at $0.10)
ADAPTER_SCRAPE=local
# local | monid (needs MONID_API_KEY and MONID_TOOLS; nothing is bought until tools are named)
ADAPTER_TOOLBUY=local
# none | openai | elevenlabs   (v1.10 §5c: elevenlabs speaks POST /api/tts and the brief;
# listening is the browser's SpeechRecognition)
ADAPTER_VOICE=none
# task 40a (D36): the voice ports, each on its own switch (ADAPTER_VOICE stays the TTS default)
# ADAPTER_TTS: elevenlabs | openai | none  (POST /api/tts and the brief audio)
ADAPTER_TTS=
# ADAPTER_REALTIME: openai | none  (POST /api/voice/session; default openai only when
# ADAPTER_VOICE=openai)
ADAPTER_REALTIME=
# ADAPTER_STT: openai | none  (POST /api/stt: the recorded audio -> {text}; needs OPENAI_API_KEY)
ADAPTER_STT=
# local | agentmail (design D27: an event on the clients inbox's calendar plus an
# iCalendar invitation to the client; needs AGENTMAIL_API_KEY and MAIL_INBOX_CLIENTS)
ADAPTER_CALENDAR=local
# local | naive (needs NAIVE_API_KEY and NAIVE_SOCIAL_IDENTITY)
ADAPTER_SOCIAL=local
# none | stripe
ADAPTER_PAY=none

# --- Voice (contract v1.1): without it, /api/voice/session and /api/brief/audio answer 503 ---
OPENAI_API_KEY=

# --- CEO updates (contract §5, D24): approvals, BLOCKED cases, a digest every N hours ---
CEO_EMAIL=
CEO_DIGEST_HOURS=3

# --- Two inboxes (contract §6c): AgentMail addresses Saturday ---
MAIL_INBOX_CLIENTS=
MAIL_INBOX_HIRING=

# --- AgentMail (ADAPTER_MAIL=agentmail, task 8) ---
# API key from the AgentMail console. MAIL_INBOX_CLIENTS (required) and MAIL_INBOX_HIRING
# are the inbox addresses, which are also their inbox ids.
AGENTMAIL_API_KEY=
# The webhook's signing secret (whsec_...): create a webhook for message.received pointing
# at https://<public-host>/hooks/agentmail, scoped to the two inboxes. Without it,
# /hooks/agentmail needs the header X-UTax-Hook-Token: <UTAX_HOOK_TOKEN> (a relay you run
# yourself); with neither it answers 503.
AGENTMAIL_WEBHOOK_SECRET=
AGENTMAIL_BASE_URL=https://api.agentmail.to
UTAX_HOOK_TOKEN=
# The review call's meeting link or phone number, shown on the calendar invitation
UTAX_CALL_LOCATION=

# --- QA phone check (ADAPTER_DEVICE=mobilerun, contract v1.7) ---
# Every memo is BCC'd to this mailbox; the cloud phone's mail app is signed in to it and
# finds each memo by its "Reference: UTX-..." last line.
MAIL_QA_BCC=
MOBILERUN_API_KEY=
# Optional: a fixed cloud phone; else the first idle Android cloud phone of the account
MOBILERUN_DEVICE_ID=
# Optional: the mail app package (default com.google.android.gm)
MOBILERUN_MAIL_APP=
# Required with mobilerun: only memos from this sender count (the clients inbox address)
MOBILERUN_MEMO_SENDER=
# Optional: the phone agent's model (default mobilerun/mobile-agent-fast)
MOBILERUN_MODEL=

# --- Apify (ADAPTER_SCRAPE=apify): the Delaware fee page and law search ---
APIFY_TOKEN=

# --- HubSpot (ADAPTER_CRM=hubspot): the CRM mirror ---
# A private app token with crm.objects.contacts.write and crm.objects.deals.write. Contacts
# and Deals each need a unique text property named utax_key (Settings > Properties).
HUBSPOT_TOKEN=
# Optional: the deal pipeline id (default "default") and a JSON map of our stages to its
# stage ids, e.g. {"memo_sent": "presentationscheduled", "call_booked": "decisionmakerboughtin"}
HUBSPOT_PIPELINE=
HUBSPOT_STAGE_MAP=

# --- Monid (ADAPTER_TOOLBUY=monid): data calls the mkt agent buys (buy_tool, v1.7.3) ---
MONID_API_KEY=
# JSON allowlist; empty = nothing can be bought. Each tool needs max_usd (its price ceiling):
# {"enrichment": {"provider": "exa", "endpoint": "search", "max_usd": "0.05", "fields": ["query"]}}
MONID_TOOLS=
# Today's ceiling across every purchase (default 1.00). Also set a run cap in Monid's dashboard.
MONID_DAILY_CAP_USD=1.00

# --- Local demo (design D26): the in-process stand-in crew plays the agents ---
# UTAX_DRIVER=local enables it; UTAX_DRIVER_PACE = seconds between tool calls (theater).
UTAX_DRIVER=
UTAX_DRIVER_PACE=1.2

# --- Posts (v1.4/v1.5): required; the gateway appends it to client posts ---
PUBLIC_TALK_URL=
# v1.6.4: a post's image_url must be https on one of these hosts (comma-separated);
# empty = posts carry no image
PUBLIC_ASSET_HOSTS=
# v1.11 (D31): the gateway's own public https base (the tunnel host). make_ad serves its
# PNGs at <UTAX_PUBLIC_URL>/assets/ad_<n>.png, and post_social accepts that host.
UTAX_PUBLIC_URL=
# v1.11: the CEO's own list of reviewers who agreed to be contacted, "Name <email>, ...".
# They become candidates (Candidate A, B...) that hr_outreach may email; never shown.
HR_CANDIDATES=
# v1.11.3: the owner's booking page (https only), offered in hr_outreach emails as
# "You can also pick a time on my calendar: <url>". Empty = the line is left out.
HR_BOOKING_URL=

# --- Public /talk (v1.5): "event" raises the per-IP limits (venue NAT): Send 90/min, mint 60/min ---
PUBLIC_MODE=
# task 13: public /talk cases per UTC day (empty = 50, or 200 with PUBLIC_MODE=event); past
# it /api/voice answers 429 at_capacity (pointing at the clients inbox), the CEO gets one
# notice that day, and voice-session mints stop too. Mints are also capped at 2x this a day,
# each booked as an estimated $0.30 against SPEND_CAP_USD (so 50 -> at most $30/day of voice)
PUBLIC_CASES_PER_DAY=

# --- CEO console link in CEO mails; templates and the voice prompt (contract §6d) ---
CEO_CONSOLE_URL=http://localhost:3200/ceo
UTAX_TEMPLATES_DIR=
UTAX_VOICE_PROMPT=

# --- Voice (OpenAI; only used with ADAPTER_VOICE=openai and a key) ---
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# v1.7.5: Realtime transcribes the customer's speech with this model (the gateway reads the
# text to open a case); without it /talk voice can't work
OPENAI_TRANSCRIBE_MODEL=whisper-1
# task 40a: POST /api/stt (ADAPTER_STT=openai). A key without the model falls back to whisper-1.
OPENAI_STT_MODEL=gpt-4o-transcribe
# the spoken language ("" = auto-detect)
OPENAI_STT_LANGUAGE=en
# /talk's speech-to-text seconds a day (purpose talk), across all visitors ($0.006/min)
STT_PUBLIC_SECONDS_PER_DAY=7200

# --- Voice (ElevenLabs, v1.10 §5c; ADAPTER_VOICE=elevenlabs; no key = 503 voice_unavailable) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5
# /talk's TTS characters a day (purpose talk), across all visitors
TTS_PUBLIC_CHARS_PER_DAY=200000
# the /talk phrase registry (agents lane); default naive/prompts/talk-phrases.json
UTAX_TALK_PHRASES=

# --- SSE heartbeat seconds (contract: 15) ---
UTAX_SSE_HEARTBEAT=15

# --- Caps ---
CAP_PER_HOUR=10
SPEND_CAP_USD=
