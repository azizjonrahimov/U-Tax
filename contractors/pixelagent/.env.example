# PixelAgent (D38): an independent contractor agent with its own TESTNET wallet.
# `python -m app.devtools market-wallets` (in backend/) writes PIXELAGENT_KEY, MPP_SECRET_KEY
# and MARKET_TOKEN into contractors/pixelagent/.env (gitignored). Never print them.
PIXELAGENT_KEY=
MARKET_URL=http://127.0.0.1:8000
MARKET_TOKEN=
MPP_SECRET_KEY=
PIXELAGENT_PORT=8020
# what U-Tax reaches for invoices (a tunnel's https URL if the gateway runs elsewhere)
PIXELAGENT_PUBLIC_URL=http://127.0.0.1:8020
PIXELAGENT_MIN_USD=0.30
PIXELAGENT_POLL_SECONDS=3
PIXELAGENT_STATE=data/pixelagent-state.json
PIXELAGENT_WORKER=1
